  "scripts": {
    "generate-icons": "node scripts/generate-dynamic-icons.js",
    "build": "tsc && vite build && electron-builder --publish never",
    "dev": "vite",
    "durable-nonce:build": "node ./scripts/build-durable-nonce",
    "eth-eip1559:decode": "node ./scripts/decode-eth-eip1559",
    "format:check": "prettier --ignore-path .gitignore --check .",
    "format:write": "prettier --ignore-path .gitignore --write .",
    "icons:build": "node ./scripts/build-icons.js",
    "lint": "eslint --quiet .",
    "lint:fix": "eslint --quiet --fix .",
    "playwright:show-report": "playwright show-report",
    "playwright:test": "playwright test",
    "playwright:test:utxo": "playwright test e2e/utxo",
    "storybook": "start-storybook -p 6006",
    "storybook:build": "build-storybook",
    "storybook:preview": "http-server storybook-static --port 6006 --silent",
    "storybook:test": "test-storybook",
    "storybook:test:ci": "build-storybook && concurrently -k -s first -n \"SB,TEST\" -c \"magenta,blue\" \"http-server storybook-static --port 6006 --silent\" \"wait-on http-get://localhost:6006/ && npx test-storybook\"",
    "test": "NODE_OPTIONS='--experimental-wasm-modules' vitest",
    "bump-bitgo-versions": "npm exec ts-node ./scripts/bump-version"
  },
